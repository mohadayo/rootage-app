# アプリ環境。production では JWT_SECRET 未設定だと起動を停止する（fail-fast）。
# ローカル開発で既定シークレットのフォールバックを使いたい場合のみ development にする。
APP_ENV=development
DB_URL=postgres://ses_quiz_user:ses_quiz_pass@localhost:5432/ses_quiz?sslmode=disable
# 本番では必ず強いランダム値を設定する（未設定だと production では起動しない）
JWT_SECRET=your-secret-key-change-in-production
OPENAI_API_KEY=sk-your-openai-api-key
SERVER_PORT=8080
CORS_ORIGIN=http://localhost:5173
ALLOWED_EMAIL_DOMAIN=example.com

# パスワードリセットメール送信（Resend）
RESEND_API_KEY=
# 送信元アドレス。onboarding@resend.dev は Resend のサンドボックス用で
# アカウント所有者本人にしか配送されないため、本番では検証済みドメインのアドレスにする。
MAIL_FROM=rootage <onboarding@resend.dev>

# 初回起動時に管理者アカウントを作成する（同じメールのユーザーが既にいる場合は何もしない）
# 設定しない場合、管理者は作成されない
ADMIN_EMAIL=
ADMIN_PASSWORD=
